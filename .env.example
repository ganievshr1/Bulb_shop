# ==================== General ====================
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# ==================== Product Service ====================
PRODUCT_SERVICE_PORT=8081
PRODUCT_DATABASE_URL=postgresql://product_user:product_pass@product-db:5432/product_db
PRODUCT_DATABASE_POOL_SIZE=20
PRODUCT_DATABASE_MAX_OVERFLOW=40

# ==================== Order Service ====================
ORDER_SERVICE_PORT=8082
ORDER_DATABASE_URL=postgresql://order_user:order_pass@order-db:5432/order_db
ORDER_DATABASE_POOL_SIZE=20
ORDER_DATABASE_MAX_OVERFLOW=40

# Product Service URL (for Order Service to call)
PRODUCT_SERVICE_URL=http://product-service:8081/api/v1

# ==================== API Gateway ====================
API_GATEWAY_PORT=80
NGINX_WORKER_PROCESSES=auto
NGINX_WORKER_CONNECTIONS=1024
NGINX_LOG_LEVEL=warn

# ==================== Database (for local development) ====================
# Product DB
PRODUCT_DB_HOST=localhost
PRODUCT_DB_PORT=5432
PRODUCT_DB_USER=product_user
PRODUCT_DB_PASSWORD=product_pass
PRODUCT_DB_NAME=product_db

# Order DB
ORDER_DB_HOST=localhost
ORDER_DB_PORT=5433
ORDER_DB_USER=order_user
ORDER_DB_PASSWORD=order_pass
ORDER_DB_NAME=order_db

# ==================== Security (for future use) ====================
SECRET_KEY=your-super-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30

# ==================== External Services (for future use) ====================
# Email Service
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@bulbshop.com

# SMS Service
SMS_API_KEY=
SMS_API_URL=
SMS_SENDER=BULBSHOP

# Payment System
PAYMENT_API_URL=
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=

# ==================== Redis (for future use) ====================
REDIS_URL=redis://redis:6379/0
REDIS_PASSWORD=

# ==================== Monitoring (for future use) ====================
SENTRY_DSN=
PROMETHEUS_ENABLED=false
GRAFANA_ENABLED=false