# ============================================
#  BulbShop - Environment Configuration
#  ВНИМАНИЕ: Никогда не коммитьте .env в Git!
# ============================================

# === Генерация секретного ключа ===
# Выполните команду для генерации безопасного ключа:
# python3 -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=change_me_to_random_32_byte_key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# ============================================
#  Database Credentials
# ============================================
# Product Service Database
PRODUCT_DB_USER=product_user
PRODUCT_DB_PASSWORD=change_me_product_secure_password
PRODUCT_DB_NAME=product_db
PRODUCT_DB_PORT=5432

# Order Service Database
ORDER_DB_USER=order_user
ORDER_DB_PASSWORD=change_me_order_secure_password
ORDER_DB_NAME=order_db
ORDER_DB_PORT=5433

# Admin Service Database
ADMIN_DB_USER=admin_user
ADMIN_DB_PASSWORD=change_me_admin_secure_password
ADMIN_DB_NAME=admin_db
ADMIN_DB_PORT=5434

# ============================================
#  Service Ports
# ============================================
PRODUCT_SERVICE_PORT=8081
ORDER_SERVICE_PORT=8082
ADMIN_SERVICE_PORT=8083
GATEWAY_PORT=80

# ============================================
#  Logging Levels (DEBUG, INFO, WARNING, ERROR)
# ============================================
PRODUCT_LOG_LEVEL=INFO
ORDER_LOG_LEVEL=INFO
ADMIN_LOG_LEVEL=INFO

# ============================================
#  Admin Credentials
# ============================================
ADMIN_LOGIN=admin
ADMIN_PASSWORD=change_me_admin_strong_password
ADMIN_EMAIL=admin@bulbshop.com
ADMIN_FULL_NAME=Администратор

# ============================================
#  Service URLs (internal Docker network)
# ============================================
PRODUCT_SERVICE_URL=http://product-service:8081/api/v1
ORDER_SERVICE_URL=http://order-service:8082/api/v1