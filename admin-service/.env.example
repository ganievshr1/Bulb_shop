# Database
DATABASE_URL=postgresql://admin_user:admin_pass@admin-db:5432/admin_db
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=40

# Service
SERVICE_NAME=admin-service
SERVICE_PORT=8083
LOG_LEVEL=INFO

# JWT Settings
JWT_SECRET_KEY=your-super-secret-jwt-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480

# Other Services
PRODUCT_SERVICE_URL=http://product-service:8081/api/v1
ORDER_SERVICE_URL=http://order-service:8082/api/v1

# Admin credentials (for initial setup)
ADMIN_LOGIN=admin
ADMIN_PASSWORD=admin123
ADMIN_EMAIL=admin@bulbshop.com
ADMIN_FULL_NAME=Администратор